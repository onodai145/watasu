# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default)
DATABASE_URL=file:../data/app.db

# PostgreSQL に切り替える場合は DATABASE_URL を書き換えて pnpm migrate を実行するだけ
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# MySQL / MariaDB
# DATABASE_URL=mysql://user:password@localhost:3306/mydb

# ── OIDC (optional — skip if using local accounts only) ───────────────────────
# Supports any OIDC provider: Google, Keycloak, Auth0, Okta, etc.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret

# ── ICE Servers (WebRTC) ──────────────────────────────────────────────────────
# STUNサーバー（カンマ区切り）。未設定時は Google の公開STUNを使用。
# STUN_URLS=stun:stun.example.com:3478,stun:stun2.example.com:3478

# TURNサーバー（対称NATや厳格なファイアウォール環境で必要）
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=myuser
# TURN_CREDENTIAL=mypassword

# ── Logging ───────────────────────────────────────────────────────────────────
# ログレベル: trace / debug / info / warn / error (デフォルト: info)
# LOG_LEVEL=info

# ファイル出力先（省略時は stdout のみ）
# LOG_FILE=logs/app.log

# カラー表示を強制無効化（production では自動で無効）
# LOG_PRETTY=0

# ── App ───────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000

# ── Reverse Proxy ─────────────────────────────────────────────────────────────
# リバースプロキシが存在するネットワークセグメントをCIDRで指定する。
# 未設定 / 0 = プロキシなし（XFFを一切信頼しない）
# TRUST_PROXY=10.0.0.0/8
# TRUST_PROXY=10.0.0.1,192.168.1.0/24
# TRUST_PROXY=1
