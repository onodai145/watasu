{
  "name": "watasu",
  "version": "1.0.0",
  "description": "P2P file transfer via WebRTC with OIDC + local auth",
  "main": "server/index.ts",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "migrate": "node scripts/update-provider.mjs && prisma generate && prisma db push",
    "typecheck": "tsc --noEmit",
    "build:ui": "pnpm -F watasu-frontend build",
    "dev:ui": "pnpm -F watasu-frontend dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@hono/session": "^0.2.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "hono": "^4.12.21",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.2.3",
    "openid-client": "^5.7.1",
    "otplib": "^12.0.1",
    "pino": "^9.0.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^3.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client"
    ]
  }
}
